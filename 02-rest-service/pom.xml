<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.ibikus.appa.hephaestus</groupId>
        <artifactId>hephaestus-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>rest-service</artifactId>
    <packaging>pom</packaging>
    <name>Hephaestus :: 02-rest-service</name>
    <description>Catalog service: contract-first production-grade REST, hexagonal architecture, JPA + PostgreSQL</description>

    <properties>
        <!-- Libraries not managed by Spring Boot; check with versions:display-property-updates -->
        <openapi-generator.version>7.17.0</openapi-generator.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <springdoc.version>3.2.0</springdoc.version>
        <swagger-request-validator.version>3.0.0</swagger-request-validator.version>
    </properties>

    <modules>
        <module>catalog</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>com.atlassian.oai</groupId>
                <artifactId>openapi-request-validator-mockmvc</artifactId>
                <version>${swagger-request-validator.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
