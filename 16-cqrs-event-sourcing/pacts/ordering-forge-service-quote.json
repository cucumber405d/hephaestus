            "protoFile": "// Forge's quote for a custom piece: price and lead time, binding until expires_at.\n// Ordering asks before it accepts a custom order and sends quote_id and price_cents with the work order request.\nsyntax = \"proto3\";\n\npackage hephaestus.forge.v1;\n\nimport \"google/protobuf/timestamp.proto\";\n\noption java_multiple_files = true;\noption java_package = \"de.ibikus.appa.hephaestus.contracts.api.forge.v1\";\n\nservice QuoteService {\n  // NOT_FOUND: unknown material; INVALID_ARGUMENT: quantity below 1.\n  rpc Quote(QuoteRequest) returns (QuoteReply);\n}\n\nmessage QuoteRequest {\n  string material = 1;\n  int32 quantity = 2;\n}\n\nmessage QuoteReply {\n  string quote_id = 1;\n  int64 price_cents = 2;\n  int32 lead_time_days = 3;\n  google.protobuf.Timestamp expires_at = 4;\n}\n"
