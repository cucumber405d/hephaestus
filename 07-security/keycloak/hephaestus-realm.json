{
  "realm": "hephaestus",
  "enabled": true,
  "displayName": "Hephaestus' Workshop",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Places and reads own orders"
      },
      {
        "name": "smith",
        "description": "Forge staff"
      },
      {
        "name": "admin",
        "description": "Reads all orders"
      },
      {
        "name": "inventory-reserver",
        "description": "Service role: may reserve stock"
      }
    ]
  },
  "clients": [
    {
      "clientId": "inventory",
      "name": "Inventory API (audience only)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "inventory-secret-local-only"
    },
    {
      "clientId": "ordering",
      "name": "Ordering service (client credentials towards Inventory)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "secret": "ordering-secret-local-only",
      "protocolMappers": [
        {
          "name": "audience-inventory",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "inventory",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "shop-gateway",
      "name": "Shop gateway (BFF)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "secret": "shop-gateway-secret-local-only",
      "redirectUris": [
        "http://localhost:8080/login/oauth2/code/keycloak",
        "http://secure-shop.localtest.me/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "audience-ordering",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ordering",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-inventory",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "inventory",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "shop-cli",
      "name": "Test client for scripts only (password grant)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-ordering",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "ordering",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "audience-inventory",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "inventory",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@hephaestus.example",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Customer",
      "credentials": [
        {
          "type": "password",
          "value": "alice",
          "temporary": false
        }
      ],
      "realmRoles": [
        "customer"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@hephaestus.example",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Smith",
      "credentials": [
        {
          "type": "password",
          "value": "bob",
          "temporary": false
        }
      ],
      "realmRoles": [
        "smith"
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@hephaestus.example",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "service-account-ordering",
      "enabled": true,
      "serviceAccountClientId": "ordering",
      "realmRoles": [
        "inventory-reserver"
      ]
    }
  ]
}
