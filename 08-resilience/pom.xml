<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.ibikus.appa.hephaestus</groupId>
        <artifactId>hephaestus-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>resilience</artifactId>
    <packaging>pom</packaging>
    <name>Hephaestus :: 08-resilience</name>
    <description>Inventory against a flaky Supplier: Resilience4j, Spring Cloud Circuit Breaker and Spring 7 built-in resilience side by side</description>

    <properties>
        <!-- Spring Cloud release train for Spring Boot 4.1 -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <!-- Core modules only: the Resilience4j Spring Boot starter targets Boot 3 -->
        <resilience4j.version>2.3.0</resilience4j.version>
        <jre.image>eclipse-temurin:25-jre</jre.image>
        <!-- Git commit of the images; CI passes -Dimage.revision=$GITHUB_SHA -->
        <image.revision>unknown</image.revision>
    </properties>

    <modules>
        <module>inventory</module>
        <module>supplier</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Before the Spring Cloud BOM: one Resilience4j version for our adapter and Spring Cloud Circuit Breaker -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <!-- Same image shape as 03: non-root, JVM sized from the container limit; each module sets
                         service.name and main.class -->
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <configuration>
                        <from>
                            <image>${jre.image}</image>
                        </from>
                        <to>
                            <image>hephaestus/resilience-${service.name}:jib</image>
                        </to>
                        <container>
                            <mainClass>${main.class}</mainClass>
                            <user>1000:1000</user>
                            <ports>
                                <port>8080</port>
                            </ports>
                            <environment>
                                <JAVA_TOOL_OPTIONS>-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError</JAVA_TOOL_OPTIONS>
                            </environment>
                            <labels>
                                <org.opencontainers.image.source>https://github.com/cucumber405d/hephaestus</org.opencontainers.image.source>
                                <org.opencontainers.image.revision>${image.revision}</org.opencontainers.image.revision>
                                <org.opencontainers.image.title>resilience-${service.name}</org.opencontainers.image.title>
                            </labels>
                        </container>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
